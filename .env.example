# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# IA — con UNA de las dos basta. Solo en el servidor: nunca con NEXT_PUBLIC_
# Opcion GRATIS (recomendada): aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash
# Respaldos de pago (opcionales). Si Gemini esta saturado, la app pasa al siguiente.
# OJO: la suscripcion de ChatGPT Plus NO sirve aqui; la API de OpenAI se cobra aparte.
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Opcional: si tienes dominio propio, con esto puedes entrar escribiendo solo "gene"
# en vez del correo completo. Supabase rechaza dominios que no existen de verdad.
# NEXT_PUBLIC_AUTH_DOMAIN=1a.com.co
