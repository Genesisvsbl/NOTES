# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# IA (console.anthropic.com -> API keys). Solo en el servidor: nunca NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Opcional: si tienes dominio propio, con esto puedes entrar escribiendo solo "gene"
# en vez del correo completo. Supabase rechaza dominios que no existen de verdad.
# NEXT_PUBLIC_AUTH_DOMAIN=1a.com.co
